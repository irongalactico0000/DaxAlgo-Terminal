<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Description>Exact trade-intent policy, paper-default/live-gated broker adapters, and durable OMS ledger. Portable macOS/Linux kernel: the Windows named-pipe IPC seam and the DPAPI confirmation store are not part of this assembly.</Description>
  </PropertyGroup>

  <!--
    Resolve the IB CSharpAPI.dll exactly as TradingTerminal.Infrastructure does. Search order:
      1. lib/CSharpAPI.dll (or the legacy lib/IBApi.dll name)
      2. $(TwsApiClientDll) supplied externally
      3. Standard per-user macOS TWS API source-build locations
      4. The default Windows TWS API install path
    The SDK-free seam and mock path always compile; only the real socket transport is HAS_IBAPI-gated.
  -->
  <PropertyGroup>
    <_LocalCSharpApiDll>$(MSBuildThisFileDirectory)..\..\..\..\lib\CSharpAPI.dll</_LocalCSharpApiDll>
    <_LocalLegacyIbApiDll>$(MSBuildThisFileDirectory)..\..\..\..\lib\IBApi.dll</_LocalLegacyIbApiDll>
    <_DefaultTwsInstallDll>C:\TWS API\source\CSharpClient\client\bin\Release\net8.0\CSharpAPI.dll</_DefaultTwsInstallDll>
    <_MacIbJtsDll>$(HOME)/IBJts/source/CSharpClient/client/bin/Release/net8.0/CSharpAPI.dll</_MacIbJtsDll>
    <_MacTwsApiDll>$(HOME)/TWS API/source/CSharpClient/client/bin/Release/net8.0/CSharpAPI.dll</_MacTwsApiDll>
    <_IsWindows>$([MSBuild]::IsOSPlatform('Windows'))</_IsWindows>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DisableIbApi)' != 'true' AND '$(_ResolvedTwsApiDll)' == '' AND Exists('$(_LocalCSharpApiDll)')">
    <_ResolvedTwsApiDll>$(_LocalCSharpApiDll)</_ResolvedTwsApiDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DisableIbApi)' != 'true' AND '$(_ResolvedTwsApiDll)' == '' AND Exists('$(_LocalLegacyIbApiDll)')">
    <_ResolvedTwsApiDll>$(_LocalLegacyIbApiDll)</_ResolvedTwsApiDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DisableIbApi)' != 'true' AND '$(_ResolvedTwsApiDll)' == '' AND '$(TwsApiClientDll)' != '' AND Exists('$(TwsApiClientDll)')">
    <_ResolvedTwsApiDll>$(TwsApiClientDll)</_ResolvedTwsApiDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DisableIbApi)' != 'true' AND '$(_IsWindows)' != 'true' AND '$(_ResolvedTwsApiDll)' == '' AND Exists('$(_MacIbJtsDll)')">
    <_ResolvedTwsApiDll>$(_MacIbJtsDll)</_ResolvedTwsApiDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DisableIbApi)' != 'true' AND '$(_IsWindows)' != 'true' AND '$(_ResolvedTwsApiDll)' == '' AND Exists('$(_MacTwsApiDll)')">
    <_ResolvedTwsApiDll>$(_MacTwsApiDll)</_ResolvedTwsApiDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DisableIbApi)' != 'true' AND '$(_ResolvedTwsApiDll)' == '' AND '$(_IsWindows)' == 'true' AND Exists('$(_DefaultTwsInstallDll)')">
    <_ResolvedTwsApiDll>$(_DefaultTwsInstallDll)</_ResolvedTwsApiDll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ResolvedTwsApiDll)' != ''">
    <DefineConstants>$(DefineConstants);HAS_IBAPI</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(_ResolvedTwsApiDll)' != ''">
    <Reference Include="CSharpAPI">
      <HintPath>$(_ResolvedTwsApiDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ReportIbApiResolution" AfterTargets="ResolveAssemblyReferences" Condition="'$(_ResolvedTwsApiDll)' != ''">
    <Message Importance="high" Text="IB CSharpAPI resolved from: $(_ResolvedTwsApiDll)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\TradingTerminal.Core\TradingTerminal.Core.csproj" />
    <ProjectReference Include="..\..\Sandbox\TradingTerminal.Sandbox.Runtime\TradingTerminal.Sandbox.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TradingTerminal.Execution.Mac" />
    <InternalsVisibleTo Include="TradingTerminal.Tests.Headless" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.OpenAPI.Net" Version="1.4.4" />
    <PackageReference Include="Google.Protobuf" Version="3.29.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
