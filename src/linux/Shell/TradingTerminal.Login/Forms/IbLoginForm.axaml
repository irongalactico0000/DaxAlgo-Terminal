<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TradingTerminal.App.Login.Forms.IbLoginForm">
  <StackPanel Spacing="8">
    <Border Classes="formNote">
      <StackPanel Spacing="6">
        <TextBlock Text="What is IB Gateway?" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap"
                   Text="IB Gateway (or TWS) is Interactive Brokers’ desktop app that must stay open on this Mac. DaxAlgo does not log into IB for you — it talks to that local app over a socket. Paper trading is the default." />
        <TextBlock TextWrapping="Wrap" Classes="fieldLabel"
                   Text="1) Install &amp; open IB Gateway (or TWS) → log in with your IBKR Paper login.  2) Enable API socket clients and allow 127.0.0.1.  3) Pick a port preset below.  4) Enter your Paper account id (DU…) in Execution Console if placing orders.  5) Connect." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Open IB Gateway download"
                  Command="{Binding OpenGatewayDownloadCommand}"
                  Padding="10,4" />
          <Button Content="Re-check Gateway"
                  Command="{Binding RecheckGatewayCommand}"
                  Padding="10,4" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="Port preset (Paper first)" Classes="fieldLabel" />
    <WrapPanel Orientation="Horizontal">
      <Button Content="TWS Paper · 7497" Margin="0,0,6,6"
              Command="{Binding ApplyPortPresetCommand}"
              CommandParameter="tws-paper"
              Padding="8,3" />
      <Button Content="Gateway Paper · 4002" Margin="0,0,6,6"
              Command="{Binding ApplyPortPresetCommand}"
              CommandParameter="gateway-paper"
              Padding="8,3" />
      <Button Content="TWS Live · 7496" Margin="0,0,6,6"
              Command="{Binding ApplyPortPresetCommand}"
              CommandParameter="tws-live"
              Padding="8,3" />
      <Button Content="Gateway Live · 4001" Margin="0,0,6,6"
              Command="{Binding ApplyPortPresetCommand}"
              CommandParameter="gateway-live"
              Padding="8,3" />
    </WrapPanel>
    <TextBlock Text="{Binding PortPresetHint}" Classes="fieldLabel" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="*,*">
      <StackPanel Grid.Column="0" Spacing="5">
        <TextBlock Text="Username (optional)" Classes="fieldLabel" />
        <TextBox Text="{Binding Username}" Watermark="IBKR username — usually only needed inside Gateway/TWS" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock Text="Password" Classes="fieldLabel" />
        <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="Optional TWS password" />
      </StackPanel>
    </Grid>
    <CheckBox Content="Remember password in macOS Keychain" IsChecked="{Binding RememberPassword}" />
    <Expander Header="Connection settings" IsExpanded="True">
      <Grid Margin="0,8,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
          <TextBlock Text="Host" Classes="fieldLabel" />
          <TextBox Text="{Binding Host}" Watermark="127.0.0.1" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
          <TextBlock Text="Port" Classes="fieldLabel" />
          <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
          <TextBlock Text="Client ID" Classes="fieldLabel" />
          <NumericUpDown Value="{Binding ClientId}" Minimum="0" Maximum="9999" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
          <TextBlock Text="Account" Classes="fieldLabel" />
          <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding AccountType}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="5">
          <TextBlock Text="Market data mode" Classes="fieldLabel" />
          <ComboBox ItemsSource="{Binding MarketDataTypes}" SelectedItem="{Binding SelectedMarketDataType}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Expander>
  </StackPanel>
</UserControl>
